{
  "name": "streamarr-web",
  "version": "0.1.0",
  "description": "Browser client for streamarr-server",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "tokens": "gh api \"repos/streamarr/streamarr-ux/contents/dist/web/tokens.css?ref=$(cat TOKENS_REF)\" -H 'Accept: application/vnd.github.raw' > src/styles/tokens.generated.css",
    "tokens:check": "gh api \"repos/streamarr/streamarr-ux/contents/dist/web/tokens.css?ref=$(cat TOKENS_REF)\" -H 'Accept: application/vnd.github.raw' | diff - src/styles/tokens.generated.css",
    "test:e2e": "playwright test",
    "schema:pull": "node scripts/pull-schema.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "npm run schema:pull && npm run codegen && git diff --exit-code -- src/graphql/schema.graphql src/graphql/generated"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamarr/streamarr-web.git"
  },
  "bugs": {
    "url": "https://github.com/streamarr/streamarr-web/issues"
  },
  "homepage": "https://github.com/streamarr/streamarr-web#readme",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@apollo/client": "^4.2.6",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@tanstack/react-router": "^1.170.17",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.0.8",
    "hls.js": "^1.6.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/fragment-matcher": "^7.1.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@playwright/test": "^1.62.1",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
